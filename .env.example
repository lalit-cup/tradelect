# ════════════════════════════════════════════════════════════════
#  TRADELECT  –  Environment Variables
#  Copy this file to .env and fill in real values before deploying
# ════════════════════════════════════════════════════════════════

# ── MySQL ────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=StrongPassword123!

# ── JWT  (change to a random 64-char string in production) ───────
JWT_SECRET=tradelect-super-secret-jwt-key-must-be-at-least-256-bits-long!

# ── Redis ────────────────────────────────────────────────────────
# (no password by default; add requirepass to redis command if needed)

# ── Email / SMTP ─────────────────────────────────────────────────
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_DISPLAY=noreply@tradelect.com
MAIL_FROM_NAME=Tradelect

# ── Admin registration key ───────────────────────────────────────
ADMIN_INVITE_KEY=CHANGE_ME_BEFORE_DEPLOY

# ── Frontend URL (used for CORS in gateway) ──────────────────────
FRONTEND_URL=http://your-server-ip
FRONTEND_URL_ALT=https://your-domain.com

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=StrongGrafanaPass!
GRAFANA_ROOT_URL=http://your-server-ip:3001

# ── Razorpay (only needed by frontend build - see frontend/.env.production) ──
# REACT_APP_RAZORPAY_KEY is set in frontend/.env.production, not here
