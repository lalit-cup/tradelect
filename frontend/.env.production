# These values are baked in at build time (npm run build)
# Set REACT_APP_API_URL to your server's public IP or domain
REACT_APP_API_URL=http://YOUR_SERVER_IP_OR_DOMAIN
REACT_APP_GRAFANA_URL=http://YOUR_SERVER_IP_OR_DOMAIN:3001
REACT_APP_ENVIRONMENT=production
REACT_APP_RAZORPAY_KEY=rzp_live_YourLiveKeyHere
